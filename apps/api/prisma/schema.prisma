// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// enum Role {
//   SUPER_ADMIN
//   ADMIN
//   STAFF
//   VIEWER
// }

enum ProductVariantType {
  TEXT
  CIRCLE
}

enum Status {
  ACTIVE
  INACTIVE
}

enum StockMovementReason {
  INITIAL // สต็อกเริ่มต้นตอนสร้าง SKU (ระบบบันทึกเอง)
  RESTOCK // รับเข้า
  SALE // ขาย (ระบบบันทึกเองตอนมี order)
  RETURN // ลูกค้าคืน (ระบบบันทึกเอง)
  DAMAGED // เสียหาย / สูญหาย
  COUNT_CORRECTION // ปรับให้ตรงกับที่นับได้จริง
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model ProductTag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model ProductCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model ProductVariant {
  id     String             @id @default(uuid()) @db.Uuid
  name   String             @unique
  status Status             @default(ACTIVE)
  type   ProductVariantType @default(TEXT)

  variants Variant[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  productOptions ProductOption[]
}

model Variant {
  id        String  @id @default(uuid()) @db.Uuid
  name      String
  colorHex  String?
  sortOrder Int     @default(0)

  productVariantId String                   @db.Uuid
  productVariant   ProductVariant           @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  skuValues        ProductSkuValue[]
  imageGroupValues ProductImageGroupValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productVariantId, name])
}

model Product {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  slug        String  @unique
  description String? @db.Text
  status      Status  @default(ACTIVE)

  categoryId String          @db.Uuid
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tags       ProductTag[]

  options     ProductOption[]
  skus        ProductSku[]
  images      ProductImage[]
  imageGroups ProductImageGroup[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model ProductOption {
  id        String  @id @default(uuid()) @db.Uuid
  sortOrder Int     @default(0)
  showImage Boolean @default(false)

  productId        String         @db.Uuid
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariantId String         @db.Uuid
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@unique([productId, productVariantId])
}

model ProductSku {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku            String   @unique
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  stock          Int      @default(0)
  status         Status   @default(ACTIVE)

  weightGrams Int?
  lengthCm    Decimal? @db.Decimal(6, 1)
  widthCm     Decimal? @db.Decimal(6, 1)
  heightCm    Decimal? @db.Decimal(6, 1)

  values        ProductSkuValue[]
  stockMovements StockMovement[]
}

model ProductSkuValue {
  skuId     String     @db.Uuid
  sku       ProductSku @relation(fields: [skuId], references: [id], onDelete: Cascade)
  variantId String     @db.Uuid
  variant   Variant    @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@id([skuId, variantId])
  @@index([variantId])
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  url       String  @unique
  alt       String?
  sortOrder Int     @default(0)

  productId String             @db.Uuid
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  groupId   String?            @db.Uuid // null = รูปหลัก (แทน variantId เดิม)
  group     ProductImageGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([productId, groupId, sortOrder])
}

/**
 * กลุ่มรูป เช่น "สีดำ" หรือ "ดำ + ลายทาง"
 */
model ProductImageGroup {
  id String @id @default(uuid()) @db.Uuid

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  values ProductImageGroupValue[]
  images ProductImage[]

  @@index([productId])
}

/**
 * ค่าของกลุ่ม เช่น กลุ่ม "ดำ + ลายทาง" มี 2 แถว
 */
model ProductImageGroupValue {
  groupId   String            @db.Uuid
  group     ProductImageGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  variantId String            @db.Uuid
  variant   Variant           @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@id([groupId, variantId])
  @@index([variantId])
}

model StockMovement {
  id    String     @id @default(uuid()) @db.Uuid
  skuId String     @db.Uuid
  sku   ProductSku @relation(fields: [skuId], references: [id], onDelete: Cascade)

  delta      Int
  stockAfter Int
  reason     StockMovementReason
  note       String?

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@index([skuId, createdAt])
  @@index([createdAt])
}
